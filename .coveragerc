# v1.0: coverage gate configuration.
#
# The coverage gate is enforced on a single Python version (3.11) in the
# CI test-matrix to avoid redundant coverage runs across all four versions.
#
# History:
#   v0.9.5 — 80% (initial gate)
#   v1.0.0 — 82% (measured ~83% after type-debt cleanup; raised from 80%)
#   v1.1.0 — target 88%
#   v1.2.0 — target 95%

[run]
# Measure only the shipped package, not the test suite or CLI helpers.
source = src/movie_narrator
omit = src/movie_narrator/__main__.py

# 82% absolute line coverage. Network-bound modules (TTS, LLM) are excluded
# from practical unit-test coverage; integration tests cover them instead.
[report]
fail_under = 82

show_missing = True
skip_covered = True
sort = miss

# Exclude boilerplate that is impractical or irrelevant to test.
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    def __repr__
    @abc.abstractmethod
    raise NotImplementedError